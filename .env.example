# Supabase Configuration (REQUIRED)
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# DO NOT USE YOUR SERVICE ROLE KEY - Use the anon/public key only
# The anon key is safe to use in frontend code

# Google Maps API Configuration (REQUIRED for map functionality)
# Get your API key from Google Cloud Console:
# https://console.cloud.google.com → Create a new project → APIs & Services → Credentials
# Enable these APIs: Maps JavaScript API, Maps Embed API

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
